# 本项目密钥配置示例（复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，不会进仓库）

# ========== 大模型：蚂蚁数科大模型服务平台（OpenAI 兼容） ==========
LLM_BASE_URL=https://你的平台端点/v1
LLM_API_KEY=在此填入你的Key
# 对话主模型（扮难缠客户 / 话术助手答疑）
LLM_DIALOG_MODEL=你的对话模型名
# 独立评估模型（点评打分，与对话模型必须分开）
LLM_EVAL_MODEL=你的评估模型名

# ========== 语音：阿里云智能语音交互 ==========
# 阿里云 AccessKey（在阿里云控制台 RAM 访问控制创建）
ALIYUN_ACCESS_KEY_ID=你的AccessKeyID
ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
# ASR / TTS 应用 appkey（在阿里云智能语音交互控制台创建项目后获得）
ALIYUN_ASR_APP_KEY=你的语音识别appkey
ALIYUN_TTS_APP_KEY=你的语音合成appkey
# 默认“思悦”（客服场景）；如需回退旧音色，改为 xiaoyun
ALIYUN_TTS_VOICE=siyue

# ========== 可选：豆包语音合成 2.0（仅替换 AI 播报，ASR 保持阿里云） ==========
# 在火山引擎豆包语音控制台开通服务、确认计费后，填入 API Key 再切换。
# 没有凭证时保持 aliyun，不会用 mock 冒充真实豆包语音。
TTS_PROVIDER=aliyun
DOUBAO_TTS_API_KEY=在此填入豆包语音APIKey
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts

# ========== 公网分享（仅线上开启，勿将真实值提交到仓库） ==========
# 每位体验者分配一个不同的高强度体验码；线上页面必须使用 HTTPS。
PUBLIC_AUTH_ENABLED=false
AUTH_SECRET=线上环境变量中填写至少32位随机字符串
INVITE_CODES=线上环境变量中填写不同体验码并用英文逗号分隔
# 临时隧道的语音 wss 地址由本地后端环境变量提供，前端不需要重建。
PUBLIC_WS_ORIGIN=wss://语音隧道地址
# DATABASE_URL=线上持久化数据库连接串
